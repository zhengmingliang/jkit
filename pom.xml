<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.alianga</groupId>
    <artifactId>jkit-parent</artifactId>
    <!-- CI-friendly 版本：全工程唯一版本号来源是下面 properties 里的 revision，
         发版只改那一处；也可用 mvn -Drevision=2.0.3 覆盖。flatten-maven-plugin
         会把发布 POM 里的 ${revision} 替换成具体版本，外部消费方无感知。 -->
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>jkit-parent</name>
    <description>jkit 多模块父工程。运行时库发布坐标仍是 com.alianga:jkit（模块目录 jkit-core）。</description>
    <url>https://github.com/zhengmingliang/jkit</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>zhengmingliang</name>
            <email>zhengmingliang911@gmail.com</email>
            <url>https://alianga.com</url>
            <organizationUrl>https://wuyongshi.top</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/zhengmingliang/jkit.git</connection>
        <developerConnection>scm:git:https://github.com/zhengmingliang/jkit.git</developerConnection>
        <url>https://github.com/zhengmingliang/jkit</url>
    </scm>

    <modules>
        <module>jkit-core</module>
        <module>jkit-curl-codegen</module>
        <module>jkit-notify</module>
        <module>jkit-notify-extra</module>
        <module>jkit-sql</module>
        <module>jkit-sql-auto</module>
        <module>jkit-sql-auto-spring-boot-2</module>
        <module>jkit-sql-auto-spring-boot-3</module>
        <module>jkit-mock</module>
    </modules>

    <properties>
        <!-- 全工程唯一版本号：升级版本只改这里（或命令行 -Drevision=x.y.z 覆盖） -->
        <revision>2.0.3</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm:ss</maven.build.timestamp.format>
    </properties>

    <build>
        <plugins>
            <!--
                Maven Toolchains：本机 ~/.m2/toolchains.xml 已声明 jdk 8/9/11/17/21。
                jkit-core 的多版本（META-INF/versions/9、/11）源码必须用 JDK 9 / 11 编译，
                因此这里把 9 与 11 提供给构建上下文；具体由 jkit-core 的 compiler 执行里
                <jdkToolchain> 选择。这样整条 reactor 可以用 JDK 8 启动 Maven，
                也能正确编译各模块的版本化源码（否则 JDK 8 下 java11 源码会因缺
                java.net.http.HttpClient 等 API 而编译失败）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>provide-toolchains</id>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>9</version>
                        </jdk>
                        <jdk>
                            <version>11</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>

            <!--
              JPMS 第一步：只固定自动模块名（写进 MANIFEST），不引入 module-info。
              模块名由各子模块的 jkit.module.name 属性提供；对 JDK8 / classpath
              用户完全无影响，模块路径上的用户拿到稳定模块名，不再随文件名变化。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>${jkit.module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!--
              CI-friendly 版本（${revision}）配套：install/deploy 时发布的是 flatten 生成的
              .flattened-pom.xml（${revision} 已被替换成具体版本号），而不是源码 POM。
              否则外部消费方拿到带 ${revision} 的 POM 会无法解析。
              resolveCiFriendliesOnly：只替换 revision/sha1/changelist 三个变量，
              POM 其余内容原样保留，发布 POM 与源码 POM 差异最小。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          发布用 profile：平时的 compile / test / package / install 完全不会碰到这里的插件，
          只有显式 -Ppublish 时才生效。id 不叫 release，避免被 settings.xml 里全局的
          <activeProfile>release</activeProfile> 自动激活。
          发布：mvn clean deploy -Ppublish
        -->
        <profile>
            <id>publish</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central-nexus-release</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <distributionManagement>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com/repository/maven-snapshots/</url>
                </snapshotRepository>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com/api/v1/publisher/upload/</url>
                </repository>
            </distributionManagement>
        </profile>
    </profiles>
</project>
